# Use either a direct OpenAI key or Vercel AI Gateway. Never expose either
# value to browser code. Vercel deployments also receive VERCEL_OIDC_TOKEN
# automatically when Gateway is the selected route.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional server-only input for derived activity recommendations. Never public forecast rows.
VISUAL_CROSSING_API_KEY=

# Select the private planner input. Public forecasts always use MET Norway.
# Open-Meteo is used only with a licensed customer key.
WEATHER_PROVIDER=open-meteo

# Set to 1 before enabling subscriptions or advertising. In commercial mode,
# WeatherView refuses to call Open-Meteo's free endpoints. A paid Open-Meteo
# key automatically switches every Open-Meteo service to its customer host.
COMMERCIAL_MODE=1
OPEN_METEO_API_KEY=

# Optional; the default is the cost-sensitive GPT-5.6 tier selected for WeatherView.
STORY_MODEL=gpt-5.6-luna

# Optional comma-separated override for the editorial city scan.
# STORY_CITIES=toronto,montreal,vancouver,new-york,chicago

# Enable only after establishing separate RainViewer commercial API rights.
RAINVIEWER_LICENSED=0
